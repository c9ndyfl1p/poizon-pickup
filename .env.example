# Telegram BotFather token. Leave empty for anonymous local preview.
BOT_TOKEN=

# Set a strong password before exposing the app beyond your own computer.
ADMIN_PASSWORD=local-demo-only

# Set the current Pronto CNY rate here. The app adds 0.25 RUB automatically.
# If left blank, the app shows a clearly marked example rate of 13.55 RUB.
PRONTO_RATE=
