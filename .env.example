# Telegram BotFather token. When set, anonymous order submission is disabled.
BOT_TOKEN=

# Required for the admin page. Generate a unique password of at least 12 characters.
ADMIN_PASSWORD=

# Used only to seed a new database. After startup, update the rate in /admin.
PRONTO_RATE=

# Used by local browser previews only. Ignored whenever BOT_TOKEN is set.
ALLOW_ANONYMOUS_ORDERS=false

# Optional shared secret for a Telegram bot to synchronize settings:
# PUT /api/bot/settings with X-Bot-Settings-Token.
BOT_SETTINGS_TOKEN=
